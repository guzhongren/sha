{
  "name": "@guzhongren/sha",
  "version": "0.1.4",
  "type": "module",
  "description": "个人 Astro 博客主题 — 开箱即用的内容驱动博客",
  "license": "MIT",
  "author": "guzhongren",
  "keywords": [
    "astro",
    "astro-component",
    "astro-integration",
    "withastro",
    "blog",
    "theme"
  ],
  "files": [
    "src/",
    "create.mjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "create-sha-blog": "./create.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content.ts",
    "./styles.css": "./src/styles/global.css"
  },
  "scripts": {
    "dev": "cd example && astro dev",
    "sync": "cd example && astro sync",
    "check": "cd example && astro check",
    "build": "cd example && astro build",
    "preview": "cd example && astro preview",
    "test:e2e": "ASTRO_TELEMETRY_DISABLED=1 pnpm build && ASTRO_TELEMETRY_DISABLED=1 playwright test"
  },
  "peerDependencies": {
    "@astrojs/markdown-remark": "^7.0.0",
    "@astrojs/mdx": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.1.3",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.92",
    "astro-icon": "^1.1.5",
    "echarts": "^6.1.0",
    "gemoji": "^8.1.0",
    "mermaid": "^11.16.0",
    "pagefind": "^1.5.2",
    "plantuml-encoder": "^1.4.0",
    "remark-gemoji": "^8.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.5.1"
}
