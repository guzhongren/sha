---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import config from "virtual:blog-theme/config";
import { accentClasses } from "../../accent";
import { isPublished, uniqueSorted, withBase } from "../../utils";

export function getStaticPaths() {
  return [{ params: {} }];
}

const posts = (await getCollection("posts")).filter(isPublished);
const categories = uniqueSorted(posts.map((post) => post.data.category).filter(Boolean));
const accent = accentClasses(config.theme.accent);
---

<BaseLayout title="Categories" description="Browse posts by category">
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <p class="eyebrow">Index</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-gray-950 dark:text-white">Categories</h1>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {categories.map((category) => <a class:list={["block rounded-xl border border-gray-950/[0.08] bg-gray-950/[0.025] p-4 text-gray-950 dark:border-white/10 dark:bg-white/5 dark:text-white", accent.hoverBorder]} href={withBase(`/categories/${category}`)}>{category}</a>)}
    </div>
  </section>
</BaseLayout>
