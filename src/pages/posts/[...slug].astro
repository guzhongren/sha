---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import TagList from "../../components/TagList.astro";
import { renderEmojiShortcodes } from "../../emoji";
import config from "virtual:blog-theme/config";
import { accentClasses } from "../../accent";
import { formatDate, isPublished, withBase } from "../../utils";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter(isPublished);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const accent = accentClasses(config.theme.accent);
const title = renderEmojiShortcodes(post.data.title);
const description = renderEmojiShortcodes(post.data.description);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto grid max-w-6xl grid-cols-1 xl:grid-cols-[minmax(0,1fr)_18rem]">
    <article class="min-w-0 px-4 py-12 sm:px-6 lg:px-10" data-pagefind-body>
      <p class="eyebrow">
        <a class:list={[accent.hoverText]} href={withBase(`/categories/${post.data.category}`)} data-pagefind-meta="category">{post.data.category}</a>
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-gray-950 dark:text-white">{title}</h1>
      <p class="mt-5 max-w-2xl text-base/7 text-gray-500 dark:text-gray-400">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
        {post.data.publishDate && <time datetime={post.data.publishDate.toISOString()} data-pagefind-meta="date">{formatDate(post.data.publishDate)}</time>}
        {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
      </div>
      <div class="mt-6">
        <TagList tags={post.data.tags} />
      </div>
      {
        post.data.cover && (
          <img class="mt-10 aspect-[16/8] w-full rounded-xl border border-gray-950/[0.08] object-cover dark:border-white/10" src={withBase(post.data.cover)} alt="" />
        )
      }
      <div class="prose mt-10 max-w-none" data-emoji-shortcodes>
        <Content />
      </div>
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
