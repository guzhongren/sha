---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublished, uniqueSorted, withBase } from "../../utils";

export function getStaticPaths() {
  return [{ params: {} }];
}

const posts = (await getCollection("posts")).filter(isPublished);
const tags = uniqueSorted(posts.flatMap((post) => post.data.tags).filter(Boolean));
---

<BaseLayout title="Tags" description="Browse posts by tag">
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <p class="font-mono text-xs font-medium uppercase tracking-widest text-[var(--text-muted)]">Index</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--text-strong)]">Tags</h1>
    <div class="mt-8 flex flex-wrap gap-3">
      {tags.map((tag) => <a class="rounded-full border border-[var(--border-soft)] px-3 py-1.5 text-sm text-[var(--text-muted)] hover:text-[var(--accent)]" href={withBase(`/tags/${tag}`)}>{tag}</a>)}
    </div>
  </section>
</BaseLayout>
