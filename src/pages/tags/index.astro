---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import config from "virtual:blog-theme/config";
import { accentClasses } from "../../accent";
import { isPublished, uniqueSorted, withBase } from "../../utils";

export function getStaticPaths() {
  return [{ params: {} }];
}

const posts = (await getCollection("posts")).filter(isPublished);
const tags = uniqueSorted(posts.flatMap((post) => post.data.tags).filter(Boolean));
const accent = accentClasses(config.theme.accent);
---

<BaseLayout title="Tags" description="Browse posts by tag">
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <p class="eyebrow">Index</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-gray-950 dark:text-white">Tags</h1>
    <div class="mt-8 flex flex-wrap gap-3">
      {tags.map((tag) => <a class:list={["pill pill-md", accent.hoverText]} href={withBase(`/tags/${tag}`)}>{tag}</a>)}
    </div>
  </section>
</BaseLayout>
