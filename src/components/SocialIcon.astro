---
import { Icon } from "astro-icon/components";
import { SOCIAL_ICONIFY_NAMES } from "../socialIcons";
import type { SocialIcon } from "../types";

interface Props {
  name: SocialIcon;
}

const { name } = Astro.props;
---

<Icon name={SOCIAL_ICONIFY_NAMES[name]} class="size-5" aria-hidden="true" />
