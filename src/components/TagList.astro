---
import config from "virtual:blog-theme/config";
import { accentClasses } from "../accent";
import { withBase } from "../utils";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const accent = accentClasses(config.theme.accent);
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <a class:list={["pill", accent.hoverText]} href={withBase(`/tags/${tag}`)}>
          {tag}
        </a>
      ))}
    </div>
  )
}
