---
import SocialIcon from "./SocialIcon.astro";
import type { SocialIcon as SocialIconName } from "../types";
import config from "virtual:blog-theme/config";
import { accentClasses } from "../accent";
import { withBase } from "../utils";

interface Props {
  icon: SocialIconName;
  href: string;
  label: string;
}

const { icon, href, label } = Astro.props;
const isWechat = icon === "wechat";
const accent = accentClasses(config.theme.accent);
---

{
  isWechat ? (
    <a
      class:list={["btn-plain group relative", accent.hoverText]}
      href={withBase(href)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={label}
      title={label}
    >
      <SocialIcon name={icon} />
      <span class="absolute bottom-full left-1/2 z-10 mb-3 hidden w-max -translate-x-1/2 rounded-lg border border-gray-950/[0.08] bg-white p-2 shadow-lg group-hover:block group-focus-within:block dark:border-white/10 dark:bg-gray-950">
        <img src={withBase(href)} alt={`${label} QR code`} class="max-h-64 min-w-32 max-w-64 rounded-sm bg-white" />
      </span>
    </a>
  ) : (
    <a
      class:list={["btn-plain", accent.hoverText]}
      href={withBase(href)}
      aria-label={label}
      title={label}
    >
      <SocialIcon name={icon} />
    </a>
  )
}
