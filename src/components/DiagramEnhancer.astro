---
import type { NormalizedBlogThemeOptions } from "../types";

interface Props {
  diagrams: NormalizedBlogThemeOptions["diagrams"];
}

const { diagrams } = Astro.props;
---

<script id="blog-theme-diagrams" type="application/json" set:html={JSON.stringify(diagrams)}></script>

<script>
  // `viz-global.js` is the Graphviz layout engine that the PlantUML build needs
  // for class/state/component diagrams. It is a classic script that publishes
  // `globalThis.Viz`, so it is loaded by URL instead of being bundled.
  import vizGlobalUrl from "@plantuml/core/viz-global.js?url";
  // The engine is served as-is. Bundling it rewrites the state it sets up at
  // module scope, so it is imported from its own file at runtime.
  import plantumlUrl from "@plantuml/core/plantuml.js?url";
  import plantumlThemesUrl from "@plantuml/core/themes.js?url";

  function readDiagramConfig() {
    const element = document.getElementById("blog-theme-diagrams");
    return element?.textContent ? JSON.parse(element.textContent) : null;
  }

  function diagramBlocks(language) {
    return [
      ...document.querySelectorAll(`pre[data-language="${language}"] > code`),
      ...document.querySelectorAll(`pre > code.language-${language}`),
    ];
  }

  function plantUmlBlocks() {
    return [
      ...diagramBlocks("plantuml"),
      ...[...document.querySelectorAll('pre[data-language="plaintext"] > code')].filter((code) =>
        (code.textContent || "").trimStart().startsWith("@startuml"),
      ),
    ];
  }

  function diagramLines(text) {
    const lines = text.split(/\r\n|\r|\n/);
    if (lines.length > 1 && lines[lines.length - 1] === "") lines.pop();
    return lines;
  }

  function loadScript(url) {
    return new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = url;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Failed to load ${url}`));
      document.head.append(script);
    });
  }

  let plantUmlEngine = null;

  /**
   * PlantUML resolves `themes.js` and the standard-library bundles against the
   * page, so the page has to provide them itself: the themes ship with the
   * engine, and standard-library bundles (`!include <C4/...>`, sprites, ...)
   * are fetched from `PLANTUML_STDLIB_BASE` when a diagram asks for one.
   *
   * The engine is only fetched when a diagram is about to render, so pages
   * without PlantUML blocks never download its several megabytes.
   */
  function loadPlantUmlEngine(plantuml) {
    plantUmlEngine ??= (async () => {
      if (plantuml.stdlibBase) {
        Object.assign(window, { PLANTUML_STDLIB_BASE: plantuml.stdlibBase });
      }
      await loadScript(vizGlobalUrl);
      if (plantuml.themes) await loadScript(plantumlThemesUrl);
      return import(/* @vite-ignore */ plantumlUrl);
    })().catch((error) => {
      // Let a later page view retry instead of caching the failure.
      plantUmlEngine = null;
      throw error;
    });
    return plantUmlEngine;
  }

  function plantUmlSvg(markup) {
    const parsed = new DOMParser().parseFromString(markup, "image/svg+xml");
    const svg = parsed.documentElement;
    if (parsed.querySelector("parsererror") || svg.tagName.toLowerCase() !== "svg") return null;

    // Diagram sources can pull in remote content (`!include`), so the markup
    // is kept inert before it enters the page.
    svg.querySelectorAll("script").forEach((node) => node.remove());
    svg.querySelectorAll("*").forEach((node) => {
      for (const attribute of [...node.attributes]) {
        if (/^on/i.test(attribute.name) || /^\s*javascript:/i.test(attribute.value)) {
          node.removeAttribute(attribute.name);
        }
      }
    });

    svg.setAttribute("role", "img");
    svg.setAttribute("aria-label", "PlantUML diagram");
    return document.importNode(svg, true);
  }

  function renderPlantUmlSvg(renderToString, lines, dark) {
    return new Promise((resolve, reject) => {
      renderToString(
        lines,
        (svg) => resolve(svg),
        (message) =>
          reject(new Error(typeof message === "string" ? message : "PlantUML render failed")),
        { dark },
      );
    });
  }

  async function renderPlantUml(plantuml) {
    if (!plantuml.enabled) return;

    const blocks = plantUmlBlocks();
    if (blocks.length === 0) return;

    let started = false;
    const start = async () => {
      if (started) return;
      started = true;

      let engine;
      try {
        engine = await loadPlantUmlEngine(plantuml);
      } catch (error) {
        blocks.forEach((code) => {
          code.parentElement.dataset.diagramError = "plantuml";
        });
        console.error(error);
        return;
      }

      /*
       * The engine keeps the diagram it is working on in module state and the
       * next call overwrites it, so renders have to be serialized. The page
       * theme is read once, like Mermaid, because the SVG bakes its colors in.
       */
      const dark = document.documentElement.classList.contains("dark");
      for (const code of blocks) {
        const pre = code.parentElement;
        try {
          const markup = await renderPlantUmlSvg(
            engine.renderToString,
            diagramLines(code.textContent || ""),
            dark,
          );
          const svg = plantUmlSvg(markup);
          if (!svg) throw new Error("unparsable PlantUML SVG");

          const figure = document.createElement("figure");
          figure.className = "diagram diagram-plantuml";
          figure.dataset.diagramTheme = dark ? "dark" : "light";
          figure.append(svg);
          pre.replaceWith(figure);
        } catch (error) {
          // The code block stays readable when the diagram cannot be drawn.
          pre.dataset.diagramError = "plantuml";
          console.error(error);
        }
      }
    };

    // Loading the engine costs a few megabytes, so the first diagram close to
    // the viewport triggers the render instead of the initial page load.
    if (!("IntersectionObserver" in window)) {
      start();
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        start();
      },
      { rootMargin: "200px" },
    );
    blocks.forEach((code) => observer.observe(code.parentElement));
  }

  async function renderMermaid(diagrams) {
    if (!diagrams.mermaid) return;

    const blocks = diagramBlocks("mermaid");
    if (blocks.length === 0) return;

    const { default: mermaid } = await import("mermaid/dist/mermaid.esm.min.mjs");
    // Mermaid writes the font into the generated SVG (and into htmlLabels), so
    // the page stack has to be passed through its config instead of CSS.
    const fontFamily = getComputedStyle(document.documentElement).fontFamily;
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: document.documentElement.classList.contains("dark") ? "dark" : "default",
      fontFamily,
      themeVariables: { fontFamily },
    });

    await Promise.all(
      blocks.map(async (code, index) => {
        const pre = code.parentElement;
        const source = code.textContent || "";
        const figure = document.createElement("figure");
        figure.className = "diagram diagram-mermaid";

        try {
          const { svg } = await mermaid.render(`mermaid-${index}`, source);
          figure.innerHTML = svg;
          pre.replaceWith(figure);
        } catch (error) {
          pre.dataset.diagramError = "mermaid";
          console.error(error);
        }
      }),
    );
  }

  const diagrams = readDiagramConfig();
  if (diagrams) {
    renderPlantUml(diagrams.plantuml);
    renderMermaid(diagrams);
  }
</script>
