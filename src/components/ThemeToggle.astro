<button
  type="button"
  class="grid size-8 cursor-pointer place-items-center rounded-full border border-[var(--border-soft)] text-sm text-[var(--text-muted)] hover:text-[var(--text-strong)]"
  aria-label="Toggle color theme"
  data-theme-toggle
>
  ◐
</button>

<script>
  const button = document.querySelector("[data-theme-toggle]");
  const modes = ["system", "light", "dark"];

  button?.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme || "system";
    const next = modes[(modes.indexOf(current) + 1) % modes.length];
    localStorage.setItem("theme", next);
    document.documentElement.dataset.theme = next;
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    document.documentElement.classList.toggle("dark", next === "dark" || (next === "system" && prefersDark));
  });
</script>
