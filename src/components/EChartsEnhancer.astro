<script>
  const chartBlocks = [...document.querySelectorAll("[data-echarts-options]")];

  if (chartBlocks.length > 0) {
    const echarts = await import("echarts");

    chartBlocks.forEach((chart, index) => {
      const figure = chart.closest(".echarts-frame");
      const caption = document.createElement("figcaption");

      chart.setAttribute("role", "img");
      chart.setAttribute("aria-label", `ECharts chart ${index + 1}`);
      caption.className = "utility-note echarts-error";
      caption.hidden = true;
      figure?.append(caption);

      try {
        const options = JSON.parse(decodeURIComponent(chart.getAttribute("data-echarts-options") || "%7B%7D"));
        // Chart text is painted into a canvas, so it cannot inherit the page
        // font through CSS. Hand ECharts the container's resolved stack; chart
        // authors can still override any specific textStyle they set.
        const fontFamily = getComputedStyle(chart).fontFamily;
        const instance = echarts.init(chart, document.documentElement.classList.contains("dark") ? "dark" : undefined);
        instance.setOption({ ...options, textStyle: { fontFamily, ...options.textStyle } });
        // Canvas text leaves nothing in the DOM to inspect, so record the
        // resolved stack for styling hooks and tests.
        chart.dataset.chartFont = fontFamily;

        const resize = () => instance.resize();
        window.addEventListener("resize", resize);
      } catch (error) {
        caption.hidden = false;
        caption.textContent = "Invalid ECharts options.";
        console.error(error);
      }
    });
  }
</script>
