---
import config from "virtual:blog-theme/config";
import { accentClasses } from "../accent";

interface Props {
  current: number;
  total: number;
  base: string;
}

const { current, total, base } = Astro.props;
const accent = accentClasses(config.theme.accent);

/**
 * Windowed page list: keep the first/last pages and the neighbors of the
 * current page, collapsing the rest behind ellipsis markers.
 */
function pageItems(current: number, total: number): (number | "…")[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, index) => index + 1);
  }
  const items: (number | "…")[] = [1];
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  if (start > 2) items.push("…");
  for (let page = start; page <= end; page += 1) items.push(page);
  if (end < total - 1) items.push("…");
  items.push(total);
  return items;
}

/** `base` is the first page href (already base-URL prefixed by call sites). */
function pageHref(page: number) {
  return page === 1 ? base : `${base}page/${page}/`;
}
---

{
  total > 1 && (
    <nav class="mt-12 border-t border-gray-950/[0.08] pt-8 dark:border-white/10" aria-label="Pagination">
      <div class="flex flex-col items-center gap-3 sm:grid sm:grid-cols-[1fr_auto_1fr] sm:gap-4">
        {current > 1 ? (
          <a
            class:list={["btn", accent.hoverBorder, accent.hoverText, "sm:justify-self-start"]}
            href={current === 2 ? base : `${base}page/${current - 1}/`}
          >
            <span aria-hidden="true">←</span>
            Newer posts
          </a>
        ) : (
          <span class="hidden sm:block" />
        )}

        <ol class="flex flex-wrap items-center justify-center gap-2" aria-label="Pages">
          {pageItems(current, total).map((item) =>
            item === "…" ? (
              <li aria-hidden="true">
                <span class="grid size-8 place-items-center text-sm text-gray-500 dark:text-gray-400">…</span>
              </li>
            ) : item === current ? (
              <li>
                <span
                  aria-current="page"
                  class:list={["btn btn-page font-medium", accent.border, accent.text, accent.softBg]}
                >
                  {item}
                </span>
              </li>
            ) : (
              <li>
                <a
                  class:list={["btn btn-page", accent.hoverBorder, accent.hoverText]}
                  href={pageHref(item)}
                >
                  {item}
                </a>
              </li>
            )
          )}
        </ol>

        {current < total ? (
          <a
            class:list={["btn", accent.hoverBorder, accent.hoverText, "sm:justify-self-end"]}
            href={`${base}page/${current + 1}/`}
          >
            Older posts
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )}
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
        <span>
          Page {current} of {total}
        </span>
        <span class="text-gray-950/[0.08] dark:text-white/10" aria-hidden="true">/</span>

        <form
          class="flex flex-wrap items-center gap-2"
          novalidate
          data-page-jump
          data-page-total={total}
          data-page-current={current}
          data-page-base={base}
          hidden
        >
          <label for="pagination-page-input" class="text-gray-500 dark:text-gray-400">Go to page</label>
          <input
            id="pagination-page-input"
            class:list={["h-8 w-16 rounded-full border border-gray-950/[0.08] bg-transparent px-3 text-center text-gray-950 dark:border-white/10 dark:text-white", accent.focusBorder]}
            type="number"
            min="1"
            max={total}
            inputmode="numeric"
            autocomplete="off"
            aria-label="Page number"
          />
          <button
            type="submit"
            class:list={["btn", accent.hoverBorder, accent.hoverText]}
          >
            Go
          </button>
        </form>
      </div>
    </nav>
  )
}

<script>
  // Progressive enhancement: static sites cannot answer a GET form submit, so
  // the jump form stays hidden until this script wires it to client-side nav.
  document.querySelectorAll("[data-page-jump]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    const input = form.querySelector("input[type='number']");
    if (!input) return;

    const total = Number(form.dataset.pageTotal);
    const current = Number(form.dataset.pageCurrent);
    const rawBase = form.dataset.pageBase;
    if (!rawBase) return;
    const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
    form.hidden = false;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const target = Number(input.value);
      if (!Number.isFinite(target)) {
        input.select();
        return;
      }
      const page = Math.min(Math.max(1, Math.round(target)), total);
      if (page === current) return;
      window.location.assign(page === 1 ? base : `${base}page/${page}/`);
    });
  });
</script>
