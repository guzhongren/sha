---
import type { Post } from "../utils";
import { formatDate, postHref, withBase } from "../utils";
import { renderEmojiShortcodes } from "../emoji";
import config from "virtual:blog-theme/config";
import { accentClasses } from "../accent";
import TagList from "./TagList.astro";

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const accent = accentClasses(config.theme.accent);
const title = renderEmojiShortcodes(post.data.title);
const description = renderEmojiShortcodes(post.data.description);
---

<article
  class:list={[
    "post-item group line-b px-3 py-8 sm:px-4",
    post.data.cover && (featured ? "grid grid-cols-1 gap-6 md:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] md:items-center" : "grid grid-cols-1 gap-5 sm:grid-cols-[minmax(0,1fr)_9rem] sm:items-start"),
  ]}
>
  {
    post.data.cover && (
      <a href={postHref(post)} class:list={["surface-block block overflow-hidden p-1", !featured && "sm:order-last"]}>
        <img class:list={["w-full rounded-lg object-cover", featured ? "aspect-[16/8] md:aspect-[16/10]" : "aspect-[16/9] sm:aspect-square"]} src={withBase(post.data.cover)} alt="" />
      </a>
    )
  }
  <div>
    <p class="eyebrow leading-6">
      <a class:list={[accent.hoverText]} href={withBase(`/categories/${post.data.category}`)}>{post.data.category}</a>
      <span class="px-1 text-gray-950/[0.08] dark:text-white/10" aria-hidden="true">/</span>
      {post.data.publishDate && <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>}
    </p>
    <h2 class:list={["mt-2 font-semibold tracking-tight text-gray-950 dark:text-white", accent.groupHoverText, featured ? "text-3xl" : "text-xl"]}>
      <a href={postHref(post)}>{title}</a>
    </h2>
    <p class="mt-3 line-clamp-2 text-sm/7 break-words text-gray-500 dark:text-gray-400" title={description}>{description}</p>
    <div class="mt-5">
      <TagList tags={post.data.tags} />
    </div>
  </div>
</article>
