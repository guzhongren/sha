---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DiagramEnhancer from "../components/DiagramEnhancer.astro";
import CodeCopyEnhancer from "../components/CodeCopyEnhancer.astro";
import EmojiEnhancer from "../components/EmojiEnhancer.astro";
import HeadingLinkEnhancer from "../components/HeadingLinkEnhancer.astro";
import EChartsEnhancer from "../components/EChartsEnhancer.astro";
import SearchEnhancer from "../components/SearchEnhancer.astro";
import config from "virtual:blog-theme/config";
import { withBase } from "../utils";

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ? `${Astro.props.title} - ${config.site.title}` : config.site.title;
const description = Astro.props.description ?? config.site.description;
const defaultMode = config.theme.defaultMode;
const ga = config.analytics.googleAnalytics;
const gaInlineScript = ga
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(ga.id)}${Object.keys(ga.config).length > 0 ? `, ${JSON.stringify(ga.config)}` : ""});`
  : "";
---

<!doctype html>
<html lang={config.site.lang} data-default-theme={defaultMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {config.author.avatar && (
      <>
        <link rel="icon" href={withBase(config.author.avatar)} />
        <link rel="apple-touch-icon" href={withBase(config.author.avatar)} />
      </>
    )}
    <title>{title}</title>
    {ga && (import.meta.env.PROD || ga.includeInDev) && (
      <>
        <script is:inline type={ga.partytown ? "text/partytown" : undefined} src={`https://www.googletagmanager.com/gtag/js?id=${ga.id}`} async></script>
        <script is:inline type={ga.partytown ? "text/partytown" : undefined} set:html={gaInlineScript}></script>
      </>
    )}
    <script is:inline define:vars={{ defaultMode }}>
      (function () {
        const icons = { system: "◐", light: "☀", dark: "☾" };
        const labels = { system: "Follow system", light: "Light", dark: "Dark" };
        const prefersDarkQuery = window.matchMedia("(prefers-color-scheme: dark)");

        function currentMode() {
          return document.documentElement.dataset.theme || defaultMode || "system";
        }

        // Clicks only ever switch between the two themes. From the initial
        // "system" state, resolve to the opposite of the OS appearance so the
        // first click is always a visible change.
        function nextMode(current) {
          if (current === "light" || current === "dark") {
            return current === "light" ? "dark" : "light";
          }
          return prefersDarkQuery.matches ? "light" : "dark";
        }

        function applyMode(mode) {
          const prefersDark = prefersDarkQuery.matches;
          document.documentElement.classList.toggle("dark", mode === "dark" || (mode === "system" && prefersDark));
          document.documentElement.dataset.theme = mode;
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.textContent = icons[mode] || "◐";
            button.setAttribute("aria-label", `Toggle color theme (${labels[mode] || mode})`);
          });
        }

        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can be unavailable (private mode, blocked cookies); fall back to default.
        }
        applyMode(stored === "light" || stored === "dark" ? stored : defaultMode);

        // Delegated listener attaches before the toggles exist, so a click is
        // never lost to script-load timing. Toggles rendered later still work.
        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!target || typeof target.closest !== "function") return;
          if (!target.closest("[data-theme-toggle]")) return;
          const next = nextMode(currentMode());
          try {
            localStorage.setItem("theme", next);
          } catch {
            // Persistence is best-effort; still switch for this page.
          }
          applyMode(next);
        });

        // In "system" mode, follow OS color-scheme changes live.
        function onSchemeChange() {
          if (currentMode() === "system") applyMode("system");
        }
        if (prefersDarkQuery.addEventListener) {
          prefersDarkQuery.addEventListener("change", onSchemeChange);
        } else if (prefersDarkQuery.addListener) {
          prefersDarkQuery.addListener(onSchemeChange);
        }

        // Keep toggle icons/labels in sync once the DOM (or a view transition) is ready.
        function syncToggles() {
          applyMode(currentMode());
        }
        document.addEventListener("DOMContentLoaded", syncToggles);
        document.addEventListener("astro:page-load", syncToggles);
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-[var(--page-bg)] text-[var(--text-body)] antialiased">
    <Header />
    <div class="mx-auto grid min-h-dvh max-w-7xl grid-cols-1 pt-14 lg:grid-cols-[2rem_minmax(0,1fr)_2rem]">
      <div class="gutter-stripes hidden border-x border-[var(--border-soft)] lg:block" aria-hidden="true"></div>
      <main id="main-content">
        <slot />
      </main>
      <div class="gutter-stripes hidden border-x border-[var(--border-soft)] lg:block" aria-hidden="true"></div>
    </div>
    <Footer />
    <EmojiEnhancer />
    <HeadingLinkEnhancer />
    <EChartsEnhancer />
    <CodeCopyEnhancer />
    {config.routes.search && <SearchEnhancer />}
    {(config.diagrams.mermaid || config.diagrams.plantuml.enabled) && <DiagramEnhancer diagrams={config.diagrams} />}
  </body>
</html>
